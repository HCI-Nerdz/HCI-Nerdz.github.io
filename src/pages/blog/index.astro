---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog · HCI Nerdz"
  description="Essays on HCI, UI, and UX — respecting cognition, product representation, and heirloom software."
  active="blog"
>
  <main class="shell page">
    <h1>Blog</h1>
    <p class="lede">
      Essays and observations. For org updates, see
      <a href="/news/">News</a>.
    </p>
    <ol class="feed">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
            <a class="title" href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
