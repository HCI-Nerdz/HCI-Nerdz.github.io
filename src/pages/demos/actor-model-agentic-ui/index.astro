        { kind: 'coordinator', text: 'Discussion stays here — fork a worker when you need its full transcript.' },
      ],
    },
    {
      id: 2,
      label: 'Epoch 2',
      runChip: '2 of 4 running',
      discussionNodes: [
        {
          id: 'coord-001',
          kind: 'coordinator',
          title: 'Coordinator',
          lines: [
            { role: 'agent', text: 'Epoch 2 — CLA unblocked openshellorg. Prior epoch frozen in selector.' },
            { role: 'agent', text: 'Wait graph active: batch tag will not finalize until prohelp merge completes.' },
          ],
        },
        {
          id: 'disc-batch-tag',
          kind: 'discussion',
          title: 'Batch release framing',
          pmStatus: 'working',
          lines: [
            { role: 'agent', text: 'Reframed the release as a batch tag once dependencies clear.' },
            { role: 'agent', text: 'Spawned batch-tag task — status in worker strip only.' },
          ],
        },
      ],
      tasks: [
        {
          id: 'openshellorg-prohelp',
          title: 'openshellorg/prohelp#1',
          titleHistory: ['CLA check', 'openshellorg/prohelp#1', 'CLA cleared — merge retry'],
          summary: 'CLA signed — merge retry in progress.',
          jobStatus: 'running',
          pmStatus: 'working',
          nodeKind: 'task',
          parentId: 'disc-org-connect',
          fork: [
            { role: 'agent', text: 'CLA cleared overnight. Re-queued from mailbox summary v2.' },
            { role: 'agent', text: 'Wait graph: bitwarden-22642 must finish before batch tag.' },
          ],
        },
        {
          id: 'bitwarden-22642',
          title: 'Update bitwarden#22642',
          titleHistory: ['Heuristic slug push', 'Update bitwarden#22642'],
          summary: 'Done — on real fork slug.',
          jobStatus: 'done',
          pmStatus: 'completed',
          nodeKind: 'task',
          parentId: 'coord-001',
          action: 'Open in Cursor',
          fork: [{ role: 'agent', text: 'Push succeeded on AMDphreak/bitwarden-clients.' }],
        },
        {
          id: 'batch-tag',
          title: 'Tag batch release notes',
          titleHistory: ['Batch release notes', 'Tag batch release notes'],
          summary: 'Waiting on openshellorg + CI before execute.',
          jobStatus: 'running',
          pmStatus: 'waiting',
          nodeKind: 'task',
          parentId: 'disc-batch-tag',
          fork: [
            {
              role: 'agent',
              text: 'Declared waitOn: [openshellorg-prohelp, bitwarden-22642]. Bitwarden terminal; openshellorg still running.',
            },
          ],
        },
        {
          id: 'windows-dev-docs',
          title: 'windows-dev-docs sync',
          titleHistory: ['windows-dev-docs sync'],
          summary: 'Unread — queued when batch tag completes.',
          jobStatus: 'blocked',
          pmStatus: 'unread',
          nodeKind: 'task',
          parentId: 'disc-batch-tag',
          fork: [
            { role: 'agent', text: 'Harness warn-mode: partial dependency if started early. Holding until batch tag mailbox=done.' },
          ],
        },
      ],
      mainLines: [
        { kind: 'coordinator', text: 'Epoch 2 — CLA unblocked openshellorg. Workers re-issued; discussion thread stays thin.' },
        { kind: 'coordinator', text: 'Temporal scrubber would rewind both epochs — same feature across linear, grid, and tree.' },
      ],
    },
  ];

  let epochIdx = 0;
  let selectedId: string | null = null;
  let selectedDiscussionId: string = 'coord-001';
  let layout: Layout = 'linear';
  let demoChildCounter = 0;

  const gridEl = document.getElementById('inbox-grid')!;
  const linearEl = document.getElementById('inbox-linear')!;
  const linearNodesEl = document.getElementById('linear-nodes')!;
  const treeEl = document.getElementById('inbox-tree')!;
  const workerStripEl = document.getElementById('worker-strip')!;
  const inboxRegion = document.getElementById('inbox-region')!;
  const archiveBin = document.getElementById('archive-bin')!;
  const archiveList = document.getElementById('archive-list')!;
  const archiveMeta = document.getElementById('archive-meta')!;
  const statusLegend = document.getElementById('status-legend')!;
  const mainLinesEl = document.getElementById('main-lines')!;
  const forkPanel = document.getElementById('fork-panel')!;
  const forkTitle = document.getElementById('fork-title')!;
  const forkStatus = document.getElementById('fork-status')!;
  const forkLinesEl = document.getElementById('fork-lines')!;
  const titleIndex = document.getElementById('title-index')!;
  const runChipEl = document.getElementById('run-chip')!;
  const chapterLabel = document.getElementById('epoch-label')!;
  const busEl = document.getElementById('bus-strip')!;
  const variantBlurb = document.getElementById('variant-blurb')!;
  const temporalScrubber = document.getElementById('temporal-scrubber') as HTMLInputElement;

  function currentEpoch() {
    return epochs[epochIdx];
  }

  function findTask(id: string): Task | undefined {
    return currentEpoch().tasks.find((t) => t.id === id);
  }

  function activeTasks() {
    return currentEpoch().tasks.filter((t) => !t.archived);
  }

  function archivedTasks() {
    return currentEpoch()
      .tasks.filter((t) => t.archived)
      .sort((a, b) => (b.archivedAt ?? 0) - (a.archivedAt ?? 0));
  }

  function pmLabel(s: PmStatus) {
    const map: Record<PmStatus, string> = {
      working: 'Working',
      waiting: 'Waiting',
      unread: 'Unread',
      read: 'Read',
      needs_you: 'Needs you',
      completed: 'Completed',
    };
    return map[s];
  }

  function jobLabel(s: JobStatus) {
    return s.charAt(0).toUpperCase() + s.slice(1);
  }

  function findDiscussion(id: string): DiscussionNode | undefined {
    return currentEpoch().discussionNodes.find((n) => n.id === id);
  }

  function allTreeNodes(): Array<{ id: string; kind: NodeKind; title: string; parentId: string | null; pmStatus?: PmStatus; jobStatus?: JobStatus; summary?: string }> {
    const ch = currentEpoch();
    const nodes: Array<{ id: string; kind: NodeKind; title: string; parentId: string | null; pmStatus?: PmStatus; jobStatus?: JobStatus; summary?: string }> = [];
    ch.discussionNodes.forEach((d) => {
      nodes.push({ id: d.id, kind: d.kind, title: d.title, parentId: d.kind === 'coordinator' ? null : 'coord-001', pmStatus: d.pmStatus });
    });
    ch.tasks.filter((t) => !t.archived).forEach((t) => {
      nodes.push({ id: t.id, kind: 'task', title: t.title, parentId: t.parentId, pmStatus: t.pmStatus, jobStatus: t.jobStatus, summary: t.summary });
    });
    return nodes;
  }

  function childrenOf(parentId: string | null) {
    return allTreeNodes().filter((n) => n.parentId === parentId);
  }

  function setVariant(next: Layout) {
    layout = next;
    document.querySelectorAll('.variant-tab').forEach((tab) => {
      const on = (tab as HTMLElement).dataset.variant === next;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    const blurbs: Record<Layout, string> = {
      linear: 'Linear — coordinator and discussion nodes in a sidebar; main thread is discussion only; workers as compact status.',
      grid: 'Grid — parallel task tiles with job dots; fork on click; main thread stays thin.',
      tree: 'Tree — left-to-right spawn lineage; + adds a demo child; fork any node for full transcript.',
    };
    variantBlurb.textContent = blurbs[next];
    paint();
  }

  function renderArchive() {
    const items = archivedTasks();
    if (layout !== 'grid') {
      archiveBin.classList.add('is-hidden');
      return;
    }
    archiveBin.classList.remove('is-hidden');
    archiveMeta.textContent = items.length
      ? `${items.length} archived — restore by recency`
      : 'Empty — archive from the fork panel';
    archiveList.innerHTML = items
      .map(
        (t) => `
      <li>
        <span>${t.title}</span>
        <button type="button" data-restore="${t.id}">Restore</button>
      </li>`,
      )
      .join('');
    archiveList.querySelectorAll('[data-restore]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.restore!;
        const task = findTask(id);
        if (!task) return;
        task.archived = false;
        delete task.archivedAt;
        selectedId = id;
        paint();
      });
    });
  }

  function renderWorkerStrip() {
    const tasks = activeTasks();
    const show = layout === 'linear' || layout === 'tree';
    workerStripEl.classList.toggle('is-hidden', !show);
    if (!show) return;
    workerStripEl.innerHTML = tasks
      .map(
        (t) => `
      <button type="button" class="worker-chip status-${t.pmStatus}${selectedId === t.id ? ' is-selected' : ''}" data-id="${t.id}">
        <span class="status-dot" aria-hidden="true"></span>
        ${t.title} · ${pmLabel(t.pmStatus)}
      </button>`,
      )
      .join('');
    workerStripEl.querySelectorAll('.worker-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedId = (btn as HTMLElement).dataset.id ?? null;
        if (selectedId) {
          const task = findTask(selectedId);
          if (task?.pmStatus === 'unread') task.pmStatus = 'read';
        }
        paint();
      });
    });
  }

  function renderLinear() {
    const nodes = currentEpoch().discussionNodes;
    linearNodesEl.innerHTML = nodes
      .map(
        (n) => `
      <button type="button" class="linear-node${n.pmStatus ? ` status-${n.pmStatus}` : ''}${selectedDiscussionId === n.id ? ' is-active' : ''}" data-disc-id="${n.id}">
        <span class="linear-node-kind">${n.kind}</span>
        <span class="linear-node-title">${n.title}</span>
      </button>`,
      )
      .join('');
    linearNodesEl.querySelectorAll('[data-disc-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedDiscussionId = (btn as HTMLElement).dataset.discId!;
        selectedId = null;
        paint();
      });
    });
  }

  function renderTreeNode(node: ReturnType<typeof allTreeNodes>[0], showConnector: boolean) {
    const wrap = document.createElement('div');
    wrap.className = 'tree-node-wrap';
    if (showConnector) {
      const conn = document.createElement('span');
      conn.className = 'tree-connector';
      conn.setAttribute('aria-hidden', 'true');
      wrap.appendChild(conn);
    }
    const card = document.createElement('button');
    card.type = 'button';
    card.className = `tree-card${selectedId === node.id || (node.kind !== 'task' && selectedDiscussionId === node.id) ? ' is-selected' : ''}`;
    const statusText =
      node.kind === 'task' && node.jobStatus
        ? `${jobLabel(node.jobStatus)} · ${node.pmStatus ? pmLabel(node.pmStatus) : ''}`
        : node.pmStatus
          ? pmLabel(node.pmStatus)
          : node.kind;
    card.innerHTML = `
      <span class="tree-card-kind">${node.kind}</span>
      <span class="tree-card-title">${node.title}</span>
      <span class="tree-card-status">${statusText}</span>`;
    card.addEventListener('click', () => {
      if (node.kind === 'task') {
        selectedId = node.id;
        const task = findTask(node.id);
        if (task?.pmStatus === 'unread') task.pmStatus = 'read';
      } else {
        selectedDiscussionId = node.id;
        selectedId = null;
      }
      paint();
    });
    wrap.appendChild(card);
    const addBtn = document.createElement('button');
    addBtn.type = 'button';
    addBtn.className = 'tree-add';
    addBtn.title = 'Spawn demo child';
    addBtn.textContent = '+';
    addBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      spawnDemoChild(node.id);
    });
    wrap.appendChild(addBtn);
    return wrap;
  }

  function spawnDemoChild(parentId: string) {
    demoChildCounter += 1;
    const id = `demo-spawn-${demoChildCounter}`;
    currentEpoch().tasks.push({
      id,
      title: `Demo spawn #${demoChildCounter}`,
      titleHistory: [`Demo spawn #${demoChildCounter}`],
      summary: 'Local demo child — no harness API.',
      jobStatus: 'running',
      pmStatus: 'working',
      nodeKind: 'task',
      parentId,
      fork: [{ role: 'agent', text: 'Spawned from tree + — transcript lives in fork only.' }],
    });
    selectedId = id;
    paint();
  }

  function renderTree() {
    treeEl.innerHTML = '';
    let frontier: Array<string | null> = [null];
    let depth = 0;
    while (frontier.length > 0) {
      const col = document.createElement('div');
      col.className = 'tree-col';
      const nextFrontier: string[] = [];
      for (const parentId of frontier) {
        const kids = childrenOf(parentId);
        for (const node of kids) {
          col.appendChild(renderTreeNode(node, depth > 0));
          nextFrontier.push(node.id);
        }
      }
      if (col.childElementCount === 0) break;
      treeEl.appendChild(col);
      frontier = nextFrontier;
      depth += 1;
    }
  }

  function renderGrid() {
    const tasks = activeTasks();
    gridEl.innerHTML = tasks
      .map(
        (t) => `
      <button type="button" class="task-card status-${t.jobStatus}${selectedId === t.id ? ' is-selected' : ''}" data-id="${t.id}" role="listitem">
        <span class="task-title">${t.title}</span>
        <span class="task-summary">${t.summary}</span>
        <span class="task-foot">
          <span><span class="status-dot" aria-hidden="true"></span> ${jobLabel(t.jobStatus)}</span>
          ${t.action ? `<span class="task-action">${t.action}</span>` : ''}
        </span>
      </button>`,
      )
      .join('');

    gridEl.querySelectorAll('.task-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedId = (btn as HTMLElement).dataset.id ?? null;
        paint();
      });
    });
  }

  function renderFork() {
    if (!selectedId) {
      forkPanel.classList.add('is-hidden');
      return;
    }
    const task = findTask(selectedId);
    if (!task || task.archived) {
      forkPanel.classList.add('is-hidden');
      return;
    }
    forkPanel.classList.remove('is-hidden');
    forkTitle.textContent = task.title;
    forkStatus.textContent = `${jobLabel(task.jobStatus)} · ${pmLabel(task.pmStatus)} — fork view (cosmetic)`;
    titleIndex.innerHTML = [...task.titleHistory]
      .reverse()
      .map((t, i) => `<li>${i === 0 ? t : `↳ ${t}`}</li>`)
      .join('');
    forkLinesEl.innerHTML = task.fork.map((l) => `<li class="is-${l.role}">${l.text}</li>`).join('');
  }

  function discussionLinesForMain(): ForkLine[] {
    const disc = findDiscussion(selectedDiscussionId);
    if (disc) return disc.lines;
    return currentEpoch().mainLines.map((l) => ({ role: 'agent' as const, text: l.text }));
  }

  function renderMain() {
    const ch = currentEpoch();
    inboxRegion.classList.remove('is-hidden');

    linearEl.classList.toggle('is-hidden', layout !== 'linear');
    gridEl.classList.toggle('is-hidden', layout !== 'grid');
    treeEl.classList.toggle('is-hidden', layout !== 'tree');
    statusLegend.classList.toggle('is-hidden', layout !== 'grid');

    renderWorkerStrip();
    if (layout === 'linear') renderLinear();
    else if (layout === 'grid') renderGrid();
    else renderTree();

    const lines =
      layout === 'linear'
        ? discussionLinesForMain()
        : ch.mainLines.map((l) => ({ role: 'agent' as const, text: l.text }));
    mainLinesEl.innerHTML = lines
      .map((l) => `<li class="is-${l.role === 'user' ? 'user' : 'coordinator'}">${l.text}</li>`)
      .join('');

    const busMessages: Record<Layout, string> = {
      linear: 'Linear mode — main thread is discussion only; worker output lives in status chips and forks.',
      grid: 'Grid mode — task tiles update in place; main thread stays coordinator summaries only.',
      tree: 'Tree mode — spawn lineage left-to-right; + adds demo child; fork for full worker transcript.',
    };
    busEl.textContent = busMessages[layout];

    renderFork();
    renderArchive();

    runChipEl.textContent = ch.runChip;
    chapterLabel.textContent = ch.label;

    const scrubVal = Number(temporalScrubber.value);
    document.getElementById('thread-meta')!.textContent =
      scrubVal < 100
        ? `Temporal rewind ${100 - scrubVal}% — discussion only at this scrub`
        : 'Coordinator summaries only — workers not inlined';
  }

  function paint() {
    renderMain();
  }

  document.querySelectorAll('.variant-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      setVariant(((tab as HTMLElement).dataset.variant as Layout) ?? 'linear');
    });
  });

  document.getElementById('fork-close')!.addEventListener('click', () => {
    selectedId = null;
    paint();
  });

  document.getElementById('btn-mark-complete')!.addEventListener('click', () => {
    if (!selectedId) return;
    const task = findTask(selectedId);
    if (!task) return;
    task.pmStatus = 'completed';
    task.jobStatus = 'done';
    paint();
  });

  document.getElementById('btn-archive')!.addEventListener('click', () => {
    if (!selectedId) return;
    const task = findTask(selectedId);
    if (!task) return;
    task.archived = true;
    task.archivedAt = Date.now();
    selectedId = null;
    paint();
  });

  document.getElementById('fork-compose')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('fork-input') as HTMLInputElement;
    const text = input.value.trim();
    if (!text || !selectedId) return;
    const task = findTask(selectedId);
    if (!task) return;
    task.fork.push({ role: 'user', text });
    task.fork.push({
      role: 'agent',
      text: 'Noted in this fork only — coordinator thread gets a one-line summary on next sync.',
    });
    if (task.pmStatus === 'needs_you' || task.pmStatus === 'waiting') task.pmStatus = 'working';
    input.value = '';
    renderFork();
  });

  temporalScrubber.addEventListener('input', () => paint());

  document.getElementById('btn-next-epoch')!.addEventListener('click', () => {
    if (epochIdx < epochs.length - 1) epochIdx += 1;
    else epochIdx = 0;
    selectedId = null;
    selectedDiscussionId = 'coord-001';
    demoChildCounter = 0;
    paint();
  });

  setVariant('linear');
</script>
