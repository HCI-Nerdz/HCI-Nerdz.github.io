---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Actor-model agentic UI desk · HCI Nerdz"
  description="Interactive demo: parallel agent tasks in a grid with cosmetic fork chats — not a serialized wall of status spam."
  active="demos"
>
  <main class="shell page desk-page pi-page shell-prov">
    <p class="back-row">
      <a class="back" href="/demos/">← Demos</a>
    </p>
    <header class="desk-intro">
      <p class="eyebrow">Demo · Actor-model agentic UI</p>
      <h1>Actor-model agentic UI desk</h1>
      <p class="lede">
        Twelve repo jobs run at once. The grid shows each card's status without scrolling the main
        thread. Click a card for the localized fork. Toggle serialized mode to feel today's default.
      </p>
      <p class="related-links">
        <a href="/blog/when-chat-should-spawn-a-node/">Essay</a>
        ·
        <a href="https://hci-nerdz.github.io/docs/hci-nerdz/actor-model-agentic-ui.html">Docs</a>
        ·
        <a href="https://docs.devcentr.org/agent-rules/actor-model-agentic-ui.html">DevCentr harness</a>
      </p>
    </header>

    <section class="desk" id="desk" aria-label="Actor-model agentic UI demo">
      <div class="shell-bar">
        <div class="shell-identity">
          <span class="shell-label">Coordinator node</span>
          <strong id="run-chip">9 of 12 running</strong>
          <span class="phase" id="epoch-label">Epoch 1</span>
        </div>
        <div class="shell-controls">
          <label class="mode-toggle">
            <input type="checkbox" id="serialized-mode" />
            <span>Serialized (old way)</span>
          </label>
          <button type="button" id="btn-next-epoch" class="epoch-btn">Next epoch</button>
        </div>
      </div>

      <p class="lineage-strip" id="lineage-strip">Spawn: coord-001 → disc-org-connect → task nodes</p>

      <div class="inbox-region" id="inbox-region" aria-label="Task node grid">
        <div class="inbox-grid" id="inbox-grid" role="list"></div>
      </div>

      <div class="fork-panel is-hidden" id="fork-panel" aria-label="Node fork chat">
        <div class="fork-header">
          <button type="button" id="fork-close" class="fork-close" aria-label="Close fork">×</button>
          <div>
            <strong id="fork-title">Node</strong>
            <span class="fork-meta" id="fork-status"></span>
          </div>
        </div>
        <ol class="fork-lines" id="fork-lines"></ol>
        <form class="fork-compose" id="fork-compose">
          <input type="text" id="fork-input" placeholder="Message this node…" autocomplete="off" />
          <button type="submit">Send</button>
        </form>
      </div>

      <section class="main-thread" aria-label="Coordinator chat">
        <div class="chat-header">
          <span class="chat-title">Main thread</span>
          <span class="chat-meta" id="thread-meta">Coordinator summaries only</span>
        </div>
        <ol class="chat-lines" id="main-lines" aria-live="polite"></ol>
      </section>

      <p class="bus-strip" id="bus-strip" role="status">Grid mode — cards update in place; main thread stays thin.</p>
    </section>

    <figure class="case-shot">
      <img
        src="/demos/actor-model-agentic-ui/serialized-wall.png"
        alt="Real agent chat with repeated 9 of 12 running headers and duplicate Done cards in one scroll"
        width="960"
        height="540"
        loading="lazy"
      />
      <figcaption>
        Today's serialized surface — the problem this inbox replaces. Same aggregate header three
        times; Done cards duplicated in the scroll.
      </figcaption>
    </figure>

    <aside class="lesson">
      <h2>What you are seeing</h2>
      <ul>
        <li>
          <strong>Distinct cards</strong> — each parallel job gets one tile (not four copies of the
          same Done step).
        </li>
        <li>
          <strong>Fork on click</strong> — localized chat for that job only; canonical thread stays
          unified on disk.
        </li>
        <li>
          <strong>Mailbox summaries</strong> — blocked cards explain CLA vs permissions without loading
          sibling forks.
        </li>
        <li>
          <strong>Chapters</strong> — start Epoch 2 to re-issue the grid; prior epoch stays in the
          selector.
        </li>
        <li>
          <strong>Serialized toggle</strong> — every sub-line lands in main scroll again; feel why the
          grid exists.
        </li>
      </ul>
    </aside>
  </main>
</BaseLayout>

<style>
  .desk-page {
    max-width: 64rem;
  }

  .back-row {
    margin: 0 0 0.5rem;
  }

  .desk-intro .eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--honesty);
  }

  .related-links {
    margin: -0.5rem 0 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .desk {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background:
      linear-gradient(160deg, rgba(61, 155, 143, 0.08), transparent 45%),
      rgba(255, 255, 255, 0.02);
    animation: rise 0.7s ease both;
    position: relative;
  }

  .shell-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .shell-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .shell-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  #run-chip {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--honesty);
  }

  .phase {
    font-size: 0.85rem;
    color: var(--paper-muted);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .shell-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .mode-toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    cursor: pointer;
    user-select: none;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .epoch-btn {
    min-height: 2.4rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }

  .epoch-btn:hover {
    color: var(--focus);
  }

  .inbox-region {
    max-height: 14rem;
    overflow: auto;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.15);
  }

  .inbox-region.is-hidden {
    display: none;
  }

  .inbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 0.65rem;
  }

  .task-card {
    display: grid;
    gap: 0.45rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
    transition: border-color 0.15s ease;
  }

  .task-card:hover,
  .task-card.is-selected {
    border-color: var(--focus);
  }

  .task-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .task-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.3;
  }

  .task-summary {
    font-size: 0.78rem;
    color: var(--paper-muted);
    line-height: 1.35;
  }

  .task-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-done .status-dot {
    background: #5ecf9a;
  }

  .status-running .status-dot {
    background: #e8a54b;
    animation: pulse 1.2s ease infinite;
  }

  .status-blocked .status-dot {
    background: #c97b7b;
  }

  .status-failed .status-dot {
    background: #e05a5a;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  .task-action {
    font-size: 0.72rem;
    color: var(--focus);
    opacity: 0.85;
  }

  .fork-panel {
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .fork-panel.is-hidden {
    display: none;
  }

  .fork-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .fork-close {
    border: none;
    background: transparent;
    color: var(--paper-muted);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
  }

  .fork-meta {
    display: block;
    font-size: 0.82rem;
    color: var(--paper-muted);
    margin-top: 0.15rem;
  }

  .fork-lines {
    margin: 0;
    padding: 0.85rem 1rem;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    max-height: 10rem;
    overflow: auto;
    font-size: 0.9rem;
    color: var(--paper-muted);
  }

  .fork-lines li.is-agent {
    color: var(--paper);
  }

  .fork-lines li.is-user {
    color: var(--focus);
    font-weight: 600;
  }

  .fork-compose {
    display: flex;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border-top: 1px solid var(--line);
  }

  .fork-compose input {
    flex: 1;
    min-height: 2.2rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.2);
    color: var(--paper);
    font: inherit;
  }

  .fork-compose button {
    min-height: 2.2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }

  .main-thread {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .chat-meta {
    color: var(--paper-muted);
    font-weight: 600;
  }

  .chat-lines {
    margin: 0;
    padding: 1rem 1.1rem 1.25rem;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    min-height: 6rem;
    max-height: 12rem;
    overflow: auto;
    font-size: 0.92rem;
    color: var(--paper-muted);
  }

  .chat-lines li.is-coordinator {
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .chat-lines li.is-serialized {
    font-size: 0.85rem;
    padding-left: 0.65rem;
    border-left: 2px solid var(--line);
  }

  .bus-strip {
    margin: 0;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    font-size: 0.85rem;
    color: var(--paper-muted);
    background: rgba(255, 255, 255, 0.03);
  }

  .case-shot {
    margin: 2rem 0 0;
  }

  .case-shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
  }

  .case-shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--paper-muted);
  }

  .lesson {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .lesson h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .lesson ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .lesson li {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--paper-muted);
  }

  .lesson strong {
    color: var(--focus);
    font-family: var(--font-display);
  }
</style>

<script>
  type TaskStatus = 'done' | 'running' | 'blocked' | 'failed';

  interface ForkLine {
    role: 'agent' | 'user';
    text: string;
  }

  interface Task {
    id: string;
    title: string;
    summary: string;
    status: TaskStatus;
    action?: string;
    fork: ForkLine[];
  }

  interface Epoch {
    id: number;
    label: string;
    runChip: string;
    tasks: Task[];
    mainLines: { kind: 'coordinator' | 'serialized'; text: string }[];
  }

  const epochs: Epoch[] = [
    {
      id: 1,
      label: 'Epoch 1',
      runChip: '9 of 12 running',
      tasks: [
        {
          id: 'docs-3',
          title: 'Merge docs#3 onto main',
          summary: 'Branch pushed; GitHub is source of truth.',
          status: 'done',
          action: 'Open in Cursor',
          fork: [
            { role: 'agent', text: 'Merged dev-centr/docs#3 onto main. No conflicts.' },
            { role: 'agent', text: 'Pushed branch. CI green. Nothing for you to approve.' },
          ],
        },
        {
          id: 'vscode-299941',
          title: 'Update vscode#299941',
          summary: 'One-line docs tweak; already approved upstream.',
          status: 'done',
          action: 'Open in Cursor',
          fork: [
            { role: 'agent', text: 'Virtualization-Documentation#2002 was approved by Niels last week.' },
            { role: 'agent', text: 'Synced fork; push complete. Inspect diff only if curious.' },
          ],
        },
        {
          id: 'bitwarden-22642',
          title: 'Update bitwarden#22642',
          summary: 'Retrying on AMDphreak/bitwarden-clients…',
          status: 'running',
          fork: [
            { role: 'agent', text: 'First attempt used heuristic slug AMDphreak/clients — rejected.' },
            { role: 'agent', text: 'Verified AMDphreak/bitwarden-clients via gh repo view. Retrying push.' },
          ],
        },
        {
          id: 'openshellorg-prohelp',
          title: 'openshellorg/prohelp#1',
          summary: 'Blocked — unsigned CLA on org.',
          status: 'blocked',
          fork: [
            { role: 'agent', text: 'You own openshellorg but the Cursor GitHub App lacks write on prohelp until CLA bot clears.' },
            { role: 'agent', text: 'Mailbox: status=blocked reason=cla. Siblings should not assume this repo is green.' },
          ],
        },
        {
          id: 'libmir-asdf',
          title: 'libmir/asdf#30',
          summary: 'Blocked — external org; read-only token.',
          status: 'blocked',
          fork: [
            { role: 'agent', text: 'Not your org. App installed but cannot push without upstream merge permissions.' },
          ],
        },
        {
          id: 'unit-thread',
          title: 'atilaneves/unit-thread#12',
          summary: 'Blocked — external; waiting on maintainer.',
          status: 'blocked',
          fork: [
            { role: 'agent', text: 'Fork exists; PR needs maintainer review before agent can merge.' },
          ],
        },
      ],
      mainLines: [
        { kind: 'coordinator', text: 'Connected orgs to Cursor. Twelve repo jobs spawned; grid holds live status.' },
        { kind: 'coordinator', text: 'Three Done, three blocked (CLA + external), one running. Open a card for detail — not repeated here.' },
      ],
    },
    {
      id: 2,
      label: 'Epoch 2',
      runChip: '2 of 4 running',
      tasks: [
        {
          id: 'openshellorg-prohelp',
          title: 'openshellorg/prohelp#1',
          summary: 'CLA signed — merge retry in progress.',
          status: 'running',
          fork: [
            { role: 'agent', text: 'CLA cleared overnight. Re-queued from mailbox summary v2.' },
            { role: 'agent', text: 'Wait graph: bitwarden-22642 must finish before batch tag.' },
          ],
        },
        {
          id: 'bitwarden-22642',
          title: 'Update bitwarden#22642',
          summary: 'Done — on real fork slug.',
          status: 'done',
          action: 'Open in Cursor',
          fork: [
            { role: 'agent', text: 'Push succeeded on AMDphreak/bitwarden-clients.' },
          ],
        },
        {
          id: 'batch-tag',
          title: 'Tag batch release notes',
          summary: 'Waiting on openshellorg + CI.',
          status: 'running',
          fork: [
            { role: 'agent', text: 'Declared waitOn: [openshellorg-prohelp, bitwarden-22642]. Bitwarden terminal; openshellorg still running.' },
          ],
        },
        {
          id: 'windows-dev-docs',
          title: 'windows-dev-docs sync',
          summary: 'Queued — starts when batch tag completes.',
          status: 'blocked',
          fork: [
            { role: 'agent', text: 'Harness warn-mode: partial dependency if started early. Holding until batch tag mailbox=done.' },
          ],
        },
      ],
      mainLines: [
        { kind: 'coordinator', text: 'Epoch 2 — CLA unblocked openshellorg. Grid re-issued; prior epoch frozen in selector.' },
        { kind: 'coordinator', text: 'Wait graph active: batch tag will not finalize until prohelp merge completes.' },
      ],
    },
  ];

  let epochIdx = 0;
  let selectedId: string | null = null;

  const gridEl = document.getElementById('inbox-grid')!;
  const inboxRegion = document.getElementById('inbox-region')!;
  const mainLinesEl = document.getElementById('main-lines')!;
  const forkPanel = document.getElementById('fork-panel')!;
  const forkTitle = document.getElementById('fork-title')!;
  const forkStatus = document.getElementById('fork-status')!;
  const forkLinesEl = document.getElementById('fork-lines')!;
  const runChipEl = document.getElementById('run-chip')!;
  const chapterLabel = document.getElementById('epoch-label')!;
  const busEl = document.getElementById('bus-strip')!;
  const serializedToggle = document.getElementById('serialized-mode') as HTMLInputElement;

  function currentEpoch() {
    return epochs[epochIdx];
  }

  function findTask(id: string): Task | undefined {
    return currentEpoch().tasks.find((t) => t.id === id);
  }

  function statusLabel(s: TaskStatus) {
    return s.charAt(0).toUpperCase() + s.slice(1);
  }

  function renderGrid() {
    const ch = currentEpoch();
    gridEl.innerHTML = ch.tasks
      .map(
        (t) => `
      <button type="button" class="task-card status-${t.status}${selectedId === t.id ? ' is-selected' : ''}" data-id="${t.id}" role="listitem">
        <span class="task-title">${t.title}</span>
        <span class="task-summary">${t.summary}</span>
        <span class="task-foot">
          <span><span class="status-dot" aria-hidden="true"></span> ${statusLabel(t.status)}</span>
          ${t.action ? `<span class="task-action">${t.action}</span>` : ''}
        </span>
      </button>`,
      )
      .join('');

    gridEl.querySelectorAll('.task-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedId = (btn as HTMLElement).dataset.id ?? null;
        renderGrid();
        renderFork();
      });
    });
  }

  function renderFork() {
    if (!selectedId) {
      forkPanel.classList.add('is-hidden');
      return;
    }
    const task = findTask(selectedId);
    if (!task) {
      forkPanel.classList.add('is-hidden');
      return;
    }
    forkPanel.classList.remove('is-hidden');
    forkTitle.textContent = task.title;
    forkStatus.textContent = `${statusLabel(task.status)} — fork view (cosmetic)`;
    forkLinesEl.innerHTML = task.fork
      .map((l) => `<li class="is-${l.role}">${l.text}</li>`)
      .join('');
  }

  function renderMain() {
    const ch = currentEpoch();
    const serialized = serializedToggle.checked;

    if (serialized) {
      inboxRegion.classList.add('is-hidden');
      forkPanel.classList.add('is-hidden');
      const flat: string[] = [];
      ch.mainLines.forEach((l) => flat.push(l.text));
      ch.tasks.forEach((t) => {
        flat.push(`🔄 ${ch.runChip}. ${t.title} — ${statusLabel(t.status)}: ${t.summary}`);
        t.fork.forEach((f) => flat.push(`  ↳ ${f.text}`));
      });
      mainLinesEl.innerHTML = flat
        .map((text) => `<li class="is-serialized">${text}</li>`)
        .join('');
      busEl.textContent = 'Serialized mode — the wall returns. Scroll to reconstruct parallel state.';
    } else {
      inboxRegion.classList.remove('is-hidden');
      mainLinesEl.innerHTML = ch.mainLines
        .map((l) => `<li class="is-coordinator">${l.text}</li>`)
        .join('');
      busEl.textContent = 'Grid mode — cards update in place; main thread stays thin.';
      renderFork();
    }

    runChipEl.textContent = ch.runChip;
    chapterLabel.textContent = ch.label;
  }

  function paint() {
    renderGrid();
    renderMain();
  }

  document.getElementById('fork-close')!.addEventListener('click', () => {
    selectedId = null;
    paint();
  });

  document.getElementById('fork-compose')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('fork-input') as HTMLInputElement;
    const text = input.value.trim();
    if (!text || !selectedId) return;
    const task = findTask(selectedId);
    if (!task) return;
    task.fork.push({ role: 'user', text });
    task.fork.push({ role: 'agent', text: 'Noted in this fork only — coordinator thread gets a one-line summary on next sync.' });
    input.value = '';
    renderFork();
  });

  serializedToggle.addEventListener('change', () => {
    if (serializedToggle.checked) selectedId = null;
    paint();
  });

  document.getElementById('btn-next-epoch')!.addEventListener('click', () => {
    if (chapterIdx < epochs.length - 1) {
      epochIdx += 1;
      selectedId = null;
      paint();
    } else {
      epochIdx = 0;
      selectedId = null;
      paint();
    }
  });

  paint();
</script>
