---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GitHubLink from '../../../components/GitHubLink.astro';
---

<BaseLayout
  title="Actor-model agentic UI desk · HCI Nerdz"
  description="Linear coordinator chat, parallel task grid, and spawn tree — same node graph with cadence separation: discussion in the main thread, workers as tiles you fork for full transcript."
  active="demos"
>
  <main class="shell page desk-page pi-page shell-prov">
    <nav class="identity-strip" aria-label="Demo identity">
      <a href="/">HCI Nerdz</a>
      <span class="identity-sep" aria-hidden="true">/</span>
      <a href="/demos/">Demos</a>
      <span class="identity-sep" aria-hidden="true">/</span>
      <span aria-current="page">Actor-model agentic UI</span>
    </nav>
    <p class="vcs-row">
      <GitHubLink href="https://github.com/HCI-Nerdz/HCI-Nerdz.github.io" showStars={false} />
    </p>

    <header class="desk-intro">
      <p class="eyebrow">Demo · Actor-model agentic UI</p>
      <h1>Actor-model agentic UI desk</h1>
      <p class="lede">
        Main and discussion chat stay on a different cadence than worker output. The coordinator
        thread carries summaries and planning — not every agent line. Workers appear as tiles and
        status chips; fork a node when you need the full transcript. Linear, grid, and tree are
        projections over the same persisted graph; a temporal scrubber spans all modes when you
        need to rewind activity across parallel nodes.
      </p>
      <p class="related-links">
        <a href="/blog/persisting-agent-work-as-a-node-graph/">Essay</a>
        ·
        <a href="https://hci-nerdz.github.io/docs/hci-nerdz/actor-model-agentic-ui.html">Docs</a>
        ·
        <a href="https://docs.devcentr.org/agent-rules/actor-model-agentic-ui.html">DevCentr harness</a>
        ·
        <a href="https://hci-nerdz.github.io/piles/">Piles (email canvas sibling)</a>
      </p>
    </header>

    <figure class="case-shot lede-shot">
      <img
        src="/demos/actor-model-agentic-ui/serialized-wall.png"
        alt="Real agent chat with repeated 9 of 12 running headers and duplicate Done cards in one scroll"
        width="960"
        height="540"
        loading="eager"
      />
      <figcaption>
        Today's serialized surface — the problem this desk replaces. Same aggregate header repeated;
        Done cards duplicated in the scroll.
      </figcaption>
    </figure>

    <div class="variant-switch" role="tablist" aria-label="Desk layout">
      <button type="button" class="variant-tab is-active" role="tab" aria-selected="true" data-variant="linear" id="tab-linear">
        Linear
      </button>
      <button type="button" class="variant-tab" role="tab" aria-selected="false" data-variant="grid" id="tab-grid">
        Grid
      </button>
      <button type="button" class="variant-tab" role="tab" aria-selected="false" data-variant="tree" id="tab-tree">
        Tree
      </button>
    </div>
    <p class="variant-blurb" id="variant-blurb">
      Linear — coordinator and discussion nodes in a sidebar; main thread is discussion only; workers as compact status.
    </p>

    <section class="desk" id="desk" aria-label="Actor-model agentic UI demo">
      <div class="shell-bar">
        <div class="shell-identity">
          <span class="shell-label">Coordinator node</span>
          <strong id="run-chip">9 of 12 running</strong>
          <span class="phase" id="epoch-label">Epoch 1</span>
        </div>
        <div class="shell-controls">
          <div class="temporal-hint" id="temporal-hint" title="Temporal scrubber — rewind activity across nodes (planned)">
            <span class="temporal-label">Temporal</span>
            <input type="range" id="temporal-scrubber" min="0" max="100" value="100" aria-label="Temporal scrubber (demo)" />
          </div>
          <button type="button" id="btn-next-epoch" class="epoch-btn">Next epoch</button>
        </div>
      </div>

      <p class="lineage-strip" id="lineage-strip">Spawn: coord-001 → disc-org-connect → task nodes</p>

      <div class="status-legend" id="status-legend" aria-label="PM status legend">
        <span class="leg pm-working"><i></i> Working</span>
        <span class="leg pm-waiting"><i></i> Waiting</span>
        <span class="leg pm-unread"><i></i> Unread</span>
        <span class="leg pm-read"><i></i> Read</span>
        <span class="leg pm-needs_you"><i></i> Needs you</span>
        <span class="leg pm-completed"><i></i> Completed</span>
      </div>

      <div class="worker-strip" id="worker-strip" aria-label="Worker status"></div>

      <div class="inbox-region" id="inbox-region" aria-label="Conversation surface">
        <div class="inbox-linear is-hidden" id="inbox-linear">
          <aside class="linear-nodes" id="linear-nodes" aria-label="Discussion nodes"></aside>
        </div>
        <div class="inbox-grid is-hidden" id="inbox-grid" role="list"></div>
        <div class="inbox-tree is-hidden" id="inbox-tree" aria-label="Spawn tree"></div>
      </div>

      <aside class="archive-bin" id="archive-bin" aria-label="Archive bin">
        <div class="archive-head">
          <strong>Archive</strong>
          <span class="archive-meta" id="archive-meta">Empty — drag or archive from a card</span>
        </div>
        <ul class="archive-list" id="archive-list"></ul>
      </aside>

      <div class="fork-panel is-hidden" id="fork-panel" aria-label="Node fork chat">
        <div class="fork-header">
          <button type="button" id="fork-close" class="fork-close" aria-label="Close fork">×</button>
          <div>
            <strong id="fork-title">Node</strong>
            <span class="fork-meta" id="fork-status"></span>
          </div>
          <div class="fork-actions">
            <button type="button" id="btn-mark-complete" class="fork-action">Mark completed</button>
            <button type="button" id="btn-archive" class="fork-action">Archive</button>
          </div>
        </div>
        <ol class="title-index" id="title-index" aria-label="Title history"></ol>
        <ol class="fork-lines" id="fork-lines"></ol>
        <form class="fork-compose" id="fork-compose">
          <input type="text" id="fork-input" placeholder="Message this node…" autocomplete="off" />
          <button type="submit">Send</button>
        </form>
      </div>

      <section class="main-thread" aria-label="Coordinator chat">
        <div class="chat-header">
          <span class="chat-title">Main thread</span>
          <span class="chat-meta" id="thread-meta">Coordinator summaries only</span>
        </div>
        <ol class="chat-lines" id="main-lines" aria-live="polite"></ol>
      </section>

      <p class="bus-strip" id="bus-strip" role="status">Linear mode — main thread is discussion only; worker output lives in tiles and forks.</p>
    </section>

    <aside class="lesson">
      <h2>What you are seeing</h2>
      <ul>
        <li>
          <strong>Cadence separation</strong> — main and discussion chat carry coordinator voice;
          worker agents do not flood the scroll. Workers show as tiles and status chips; fork for
          the full transcript.
        </li>
        <li>
          <strong>Linear</strong> — discussion/coordinator nodes in a sidebar; main thread stays
          thin; workers as compact PM status, not transcript lines.
        </li>
        <li>
          <strong>Grid</strong> — parallel task tiles with job dots and summaries; fork on click;
          same store as linear.
        </li>
        <li>
          <strong>Tree</strong> — left-to-right spawn lineage; <code>+</code> adds a demo child
          node. Spawn-on-drift without polluting the parent log.
        </li>
        <li>
          <strong>PM statuses</strong> — working, waiting, unread, read, needs you, completed —
          colorized like mail, not only done/running/blocked.
        </li>
        <li>
          <strong>Temporal scrubber</strong> — spans linear, grid, and tree to rewind activity
          across parallel nodes (demo slider; full widget planned in harness).
        </li>
        <li>
          <strong>Title index</strong> — topic renames leave a bookmark stack beside the fork panel.
        </li>
      </ul>
    </aside>
  </main>
</BaseLayout>

<style>
  .desk-page {
    max-width: 64rem;
  }

  .identity-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .identity-strip a {
    color: var(--paper-muted);
    text-decoration: none;
  }

  .identity-strip a:hover {
    color: var(--focus);
  }

  .identity-sep {
    opacity: 0.45;
  }

  .vcs-row {
    margin: 0 0 1rem;
  }

  .desk-intro .eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--honesty);
  }

  .related-links {
    margin: -0.5rem 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .lede-shot {
    margin: 0 0 1.25rem;
  }

  .lede-shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
  }

  .lede-shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--paper-muted);
  }

  .variant-switch {
    display: flex;
    gap: 0.35rem;
    margin: 0 0 0.5rem;
  }

  .variant-tab {
    min-height: 2.35rem;
    padding: 0.35rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--paper-muted);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }

  .variant-tab.is-active {
    color: var(--paper);
    border-color: var(--focus);
    background: rgba(110, 181, 255, 0.12);
  }

  .variant-blurb {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    color: var(--paper-muted);
  }

  .desk {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background:
      linear-gradient(160deg, rgba(61, 155, 143, 0.08), transparent 45%),
      rgba(255, 255, 255, 0.02);
    animation: rise 0.7s ease both;
    position: relative;
  }

  .shell-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .shell-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .shell-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  #run-chip {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--honesty);
  }

  .phase {
    font-size: 0.85rem;
    color: var(--paper-muted);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .shell-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .temporal-hint {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--paper-muted);
  }

  .temporal-hint input[type='range'] {
    width: 6rem;
    accent-color: var(--focus);
  }

  .epoch-btn,
  .fork-action {
    min-height: 2.4rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }

  .epoch-btn:hover,
  .fork-action:hover {
    color: var(--focus);
  }

  .status-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.85rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--paper-muted);
  }

  .status-legend.is-hidden {
    display: none;
  }

  .leg {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .leg i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    display: inline-block;
  }

  .pm-working i,
  .status-working .status-dot,
  .worker-chip.status-working,
  .linear-node.status-working {
    --pm: #e8a54b;
  }
  .pm-waiting i,
  .status-waiting .status-dot,
  .worker-chip.status-waiting,
  .linear-node.status-waiting {
    --pm: #8b9dc3;
  }
  .pm-unread i,
  .status-unread .status-dot,
  .worker-chip.status-unread,
  .linear-node.status-unread {
    --pm: #6eb5ff;
  }
  .pm-read i,
  .status-read .status-dot,
  .worker-chip.status-read,
  .linear-node.status-read {
    --pm: #9aa3ad;
  }
  .pm-needs_you i,
  .status-needs_you .status-dot,
  .worker-chip.status-needs_you,
  .linear-node.status-needs_you {
    --pm: #c97b7b;
  }
  .pm-completed i,
  .status-completed .status-dot,
  .worker-chip.status-completed,
  .linear-node.status-completed {
    --pm: #5ecf9a;
  }

  .leg i {
    background: var(--pm, #999);
  }

  .inbox-region {
    position: relative;
    min-height: 16rem;
    max-height: 22rem;
    overflow: auto;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.18);
  }

  .inbox-region.is-hidden {
    display: none;
  }

  .inbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 0.65rem;
  }

  .inbox-grid.is-hidden,
  .inbox-linear.is-hidden,
  .inbox-tree.is-hidden,
  .archive-bin.is-hidden,
  .worker-strip.is-hidden {
    display: none;
  }

  .worker-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.12);
  }

  .worker-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--pm, var(--line));
    border-radius: 0.3rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    color: inherit;
  }

  .worker-chip:hover,
  .worker-chip.is-selected {
    border-color: var(--focus);
  }

  .inbox-linear {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 0.75rem;
    min-height: 8rem;
  }

  .linear-nodes {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .linear-node {
    display: grid;
    gap: 0.2rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--pm, var(--line));
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .linear-node.is-active {
    border-color: var(--focus);
    background: rgba(110, 181, 255, 0.1);
  }

  .linear-node-kind {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .linear-node-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    line-height: 1.25;
  }

  .inbox-tree {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    min-height: 14rem;
    overflow-x: auto;
    padding: 0.5rem 0.25rem;
  }

  .tree-col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .tree-node-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tree-card {
    display: grid;
    gap: 0.25rem;
    min-width: 9rem;
    max-width: 10.5rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
  }

  .tree-card.is-selected {
    border-color: var(--focus);
  }

  .tree-card-kind {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .tree-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .tree-card-status {
    font-size: 0.68rem;
    color: var(--paper-muted);
  }

  .tree-add {
    min-width: 1.75rem;
    min-height: 1.75rem;
    padding: 0;
    border: 1px dashed var(--line);
    border-radius: 0.3rem;
    background: transparent;
    color: var(--focus);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }

  .tree-add:hover {
    border-color: var(--focus);
    background: rgba(110, 181, 255, 0.08);
  }

  .tree-connector {
    width: 1.25rem;
    height: 2px;
    background: var(--line);
    flex-shrink: 0;
  }

  .task-card {
    display: grid;
    gap: 0.4rem;
    padding: 0.7rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
    transition: border-color 0.15s ease;
  }

  .task-card:hover,
  .task-card.is-selected {
    border-color: var(--focus);
  }

  .task-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.86rem;
    line-height: 1.3;
  }

  .task-summary {
    font-size: 0.76rem;
    color: var(--paper-muted);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .task-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
    background: var(--pm, #999);
    margin-right: 0.3rem;
  }

  .status-working .status-dot {
    animation: pulse 1.2s ease infinite;
  }

  .status-done .status-dot {
    background: #5ecf9a;
  }
  .status-running .status-dot {
    background: #e8a54b;
    animation: pulse 1.2s ease infinite;
  }
  .status-blocked .status-dot {
    background: #c97b7b;
  }
  .status-failed .status-dot {
    background: #e05a5a;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  .task-action {
    font-size: 0.72rem;
    color: var(--focus);
    opacity: 0.85;
  }

  .archive-bin {
    border: 1px dashed var(--line);
    border-radius: 0.35rem;
    padding: 0.65rem 0.75rem;
    background: rgba(0, 0, 0, 0.12);
  }

  .archive-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    margin-bottom: 0.45rem;
  }

  .archive-meta {
    color: var(--paper-muted);
    font-weight: 600;
    font-size: 0.78rem;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .archive-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .archive-list button {
    border: none;
    background: transparent;
    color: var(--focus);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    cursor: pointer;
    padding: 0;
  }

  .fork-panel {
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .fork-panel.is-hidden {
    display: none;
  }

  .fork-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .fork-close {
    border: none;
    background: transparent;
    color: var(--paper-muted);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
  }

  .fork-meta {
    display: block;
    font-size: 0.82rem;
    color: var(--paper-muted);
    margin-top: 0.15rem;
  }

  .fork-actions {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .title-index {
    margin: 0;
    padding: 0.55rem 0.85rem;
    list-style: none;
    display: grid;
    gap: 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    color: var(--paper-muted);
    font-family: var(--font-display);
  }

  .title-index:empty {
    display: none;
  }

  .title-index li:first-child {
    color: var(--paper);
    font-weight: 700;
  }

  .fork-lines {
    margin: 0;
    padding: 0.85rem 1rem;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    max-height: 10rem;
    overflow: auto;
    font-size: 0.9rem;
    color: var(--paper-muted);
  }

  .fork-lines li.is-agent {
    color: var(--paper);
  }

  .fork-lines li.is-user {
    color: var(--focus);
    font-weight: 600;
  }

  .fork-compose {
    display: flex;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border-top: 1px solid var(--line);
  }

  .fork-compose input {
    flex: 1;
    min-height: 2.2rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.2);
    color: var(--paper);
    font: inherit;
  }

  .fork-compose button {
    min-height: 2.2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }

  .main-thread {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .chat-meta {
    color: var(--paper-muted);
    font-weight: 600;
  }

  .chat-lines {
    margin: 0;
    padding: 1rem 1.1rem 1.25rem;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    min-height: 6rem;
    max-height: 12rem;
    overflow: auto;
    font-size: 0.92rem;
    color: var(--paper-muted);
  }

  .chat-lines li.is-coordinator {
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .chat-lines li.is-user {
    color: var(--focus);
    font-weight: 600;
  }

  .bus-strip {
    margin: 0;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    font-size: 0.85rem;
    color: var(--paper-muted);
    background: rgba(255, 255, 255, 0.03);
  }

  .lesson {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .lesson h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .lesson ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .lesson li {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--paper-muted);
  }

  .lesson strong {
    color: var(--focus);
    font-family: var(--font-display);
  }
</style>

<script>
  type JobStatus = 'done' | 'running' | 'blocked' | 'failed';
  type PmStatus = 'working' | 'waiting' | 'unread' | 'read' | 'needs_you' | 'completed';
  type NodeKind = 'coordinator' | 'discussion' | 'task';
  type Layout = 'linear' | 'grid' | 'tree';

  interface ForkLine {
    role: 'agent' | 'user';
    text: string;
  }

  interface DiscussionNode {
    id: string;
    kind: 'coordinator' | 'discussion';
    title: string;
    pmStatus?: PmStatus;
    lines: ForkLine[];
  }

  interface Task {
    id: string;
    title: string;
    titleHistory: string[];
    summary: string;
    jobStatus: JobStatus;
    pmStatus: PmStatus;
    nodeKind: NodeKind;
    parentId: string | null;
    action?: string;
    fork: ForkLine[];
    archived?: boolean;
    archivedAt?: number;
  }

  interface Epoch {
    id: number;
    label: string;
    runChip: string;
    discussionNodes: DiscussionNode[];
    tasks: Task[];
    mainLines: { kind: 'coordinator'; text: string }[];
  }

  const epochs: Epoch[] = [
    {
      id: 1,
      label: 'Epoch 1',
      runChip: '9 of 12 running',
      discussionNodes: [
