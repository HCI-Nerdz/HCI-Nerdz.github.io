---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubLink from '../components/GitHubLink.astro';
import DemoCard from '../components/DemoCard.astro';
import { allDemos } from '../lib/demos';
import { getCollection } from 'astro:content';

const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blog = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestNews = news.slice(0, 2);
const latestBlog = blog.slice(0, 3);
const featuredDemos = allDemos();
---

<BaseLayout active="home">
  <main class="shell">
    <section class="hero">
      <div class="hero-logotype-wrap">
        <h1 class="hero-logotype" id="hero-logotype" aria-label="HCI Nerdz">
          <span class="hero-wordmark">
            <span class="hci-word" id="hci-word">
              <span class="hci-letter hci-h" data-char="H" data-edpt="140" data-phase="0" aria-hidden="true">H</span>
              <span class="hci-letter hci-c" data-char="C" data-edpt="88" data-phase="0.9" aria-hidden="true">C</span>
            <span class="hci-letter hci-i" data-char="I" data-edpt="118" data-phase="1.7" aria-hidden="true"
              ><span class="hero-eye" id="hero-eye"
                ><svg class="hero-eye-svg" viewBox="0 0 64 40" aria-hidden="true">
                  <defs>
                    <clipPath id="hero-eye-socket">
                      <path d="M4 20 C12 6 22 4 32 4 C42 4 52 6 60 20 C52 34 42 36 32 36 C22 36 12 34 4 20 Z" />
                    </clipPath>
                    <radialGradient id="hero-iris-fill" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="var(--iris-center)" />
                      <stop offset="38%" stop-color="var(--iris-mid)" />
                      <stop offset="76%" stop-color="var(--iris-edge)" />
                      <stop offset="100%" stop-color="var(--iris-limbal)" />
                    </radialGradient>
                  </defs>
                  <path
                    class="eye-white"
                    d="M4 20 C12 6 22 4 32 4 C42 4 52 6 60 20 C52 34 42 36 32 36 C22 36 12 34 4 20 Z"
                  />
                  <g class="eye-look-clip" clip-path="url(#hero-eye-socket)">
                    <g class="eye-look" id="hero-eye-look">
                      <circle class="eye-iris-ring" cx="32" cy="20" r="16.6" />
                      <circle class="eye-iris" cx="32" cy="20" r="15.6" />
                      <circle class="eye-pupil" cx="32" cy="20" r="6.8" />
                      <circle class="eye-glint" cx="29.1" cy="17.2" r="2.5" />
                    </g>
                  </g>
                  <path class="eye-lid" d="M4 20 C12 6 22 4 32 4 C42 4 52 6 60 20 Z" />
                </svg></span
              >I</span
            >
            </span>
            <span class="nerdz-word" id="nerdz-word" aria-hidden="true">
              <span>N</span><span>e</span><span>r</span><span>d</span><span>z</span>
            </span>
          </span>
        </h1>
      </div>

      <p class="tag">
        <span data-i18n="hero.tagline">
          Human-Computer Interaction, User Interface, and User Experience think tank.
        </span>
      </p>
      <div class="cta">
        <a class="secondary" href="/blog/">
          <span data-i18n="nav.blog">Blog</span>
        </a>
        <a class="secondary" href="/demos/">
          <span data-i18n="nav.demos">Demos</span>
        </a>
        <a class="secondary" href="/news/">
          <span data-i18n="nav.news">News</span>
        </a>
        <a class="secondary" href="https://hci-nerdz.github.io/docs/">
          <span data-i18n="nav.docs">Docs</span>
        </a>
        <a class="secondary" href="/philosophy/">
          <span data-i18n="nav.philosophy">Philosophy</span>
        </a>
        <GitHubLink class="secondary cta-github" />
      </div>
      <p class="note">
        <span data-i18n="hero.note_prefix">Shell and CLI standards live at our sibling org,</span>
        <a href="https://opensh.org/">
          <span data-i18n="hero.note_org">openshellorg.</span>
        </a>
      </p>
    </section>

    <script>
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const letters = Array.from(document.querySelectorAll<HTMLElement>('.hci-letter'));
      const eye = document.getElementById('hero-eye');
      const look = document.getElementById('hero-eye-look');

      const bases = letters.map((el) => Number(el.dataset.edpt) || 100);
      const phases = letters.map((el) => Number(el.dataset.phase) || 0);

      if (!prefersReduced && letters.length) {
        const amp = 42;
        const speed = 0.002;
        const start = performance.now();
        const tick = (now: number) => {
          const t = now - start;
          letters.forEach((el, i) => {
            const wave = Math.sin(t * speed + phases[i] + i * 0.8);
            const edpt = Math.max(0, Math.min(200, bases[i] + amp * wave));
            el.style.fontVariationSettings = `"EDPT" ${edpt.toFixed(1)}, "EHLT" 12`;
          });
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      if (eye && look && !prefersReduced) {
        let targetX = 0;
        let targetY = 0;
        let curX = 0;
        let curY = 0;
        const clamp = (n: number, a: number, b: number) => Math.max(a, Math.min(b, n));

        window.addEventListener(
          'pointermove',
          (e) => {
            const r = eye.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            targetX = clamp(((e.clientX - cx) / Math.max(r.width, 1)) * 7.5, -7.5, 7.5);
            targetY = clamp(((e.clientY - cy) / Math.max(r.height, 1)) * 5, -5, 5);
          },
          { passive: true },
        );

        const loop = () => {
          curX += (targetX - curX) * 0.16;
          curY += (targetY - curY) * 0.16;
          look.setAttribute('transform', `translate(${curX.toFixed(2)} ${curY.toFixed(2)})`);
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);

        const blink = () => {
          eye.classList.add('is-blinking');
          window.setTimeout(() => eye.classList.remove('is-blinking'), 180);
        };
        const scheduleBlink = () => {
          window.setTimeout(() => {
            blink();
            scheduleBlink();
          }, 2600 + Math.random() * 3600);
        };
        scheduleBlink();
      }
    </script>

    <section class="section" aria-labelledby="principles-heading">
      <h2 id="principles-heading" data-i18n="principles.heading">What we care about</h2>
      <div class="principles-copy">
        <p data-i18n="principles.intro">
          We advocate for and invest in demonstrating discoverable surfaces that lower cognitive
          tax. Human-Computer Interaction (HCI) and User Interface/User Experience (UI/UX) design
          are foundational to how computers fit into our lives: software should respect our
          cognitive limits and attentional resources, lean on mental models people already have or
          teach better ones, and keep features and usage on the path of discoverability and least
          surprise.
        </p>
      </div>
      <ul class="principles">
        <li>
          <strong>Discoverability</strong>
          People should find what the product can do without memorizing a priesthood.
        </li>
        <li>
          <strong>UIs that promote good habits</strong>
          When a convention fights how people already think, fix it — even if the industry is used
          to it.
        </li>
        <li>
          <strong>Search, don't sort</strong>
          Put search and filters above the list you are working in — not off to the side, and not
          behind a query language people have to learn.
        </li>
        <li>
          <strong>Respect user attention</strong>
          Tools should be minimally invasive. Heirloom software over dopamine products.
        </li>
        <li>
          <strong>Scoped UX</strong>
          Many narrowly scoped tools under one roof, used together for a workflow — each tool keeps
          a clear job.
        </li>
        <li>
          <strong>Transferable knowledge</strong>
          Reuse the same core patterns across tools so learning the first one makes the next cheaper.
        </li>
      </ul>
    </section>

    <section class="section" aria-labelledby="domains-heading">
      <h2 id="domains-heading">Domains of HCI we work in</h2>
      <p class="lede">
        The repertoire is wide on purpose. Not every domain ships a flashy demo first — some start as
        diagrams and conventions.
      </p>
      <ul class="domains">
        <li>
          <a href="/demos/#navigation"><strong>Navigation</strong></a>
          <span>Edge maps, layered routes, step-by-step paths.</span>
        </li>
        <li>
          <a href="/demos/#windowing-spatial"><strong>Windowing &amp; spatial UI</strong></a>
          <span>Lite palettes, torn-off tools, multi-window desks.</span>
        </li>
        <li>
          <a href="/demos/#settings-context"><strong>Settings &amp; context</strong></a>
          <span>Bound panes and scoped tools beside the work.</span>
        </li>
        <li>
          <a href="/demos/#search-filters"><strong>Search &amp; filters</strong></a>
          <span>Discoverable filter literacy, not syntax-only doors.</span>
        </li>
        <li>
          <a href="/demos/#information-architecture"><strong>Information architecture</strong></a>
          <span>Labels, types, identity, and sequence maps.</span>
        </li>
        <li>
          <a href="/demos/#inbox-attention"><strong>Inbox &amp; attention</strong></a>
          <span>Glanceable canvases and agent task grids.</span>
        </li>
        <li>
          <a href="/demos/#feedback-trust"><strong>Feedback &amp; trust</strong></a>
          <span>Provenance marks and severity that reads true.</span>
        </li>
        <li>
          <a href="/demos/#theming-visual-contracts"><strong>Theming &amp; visual contracts</strong></a>
          <span>Previews and chrome that inherit the host.</span>
        </li>
        <li>
          <a href="/demos/#selection-dialogs"><strong>Selection &amp; dialogs</strong></a>
          <span>Unified open/save and pickers — still on the roadmap.</span>
        </li>
      </ul>
    </section>

    <section class="section" aria-labelledby="blog-heading">
      <h2 id="blog-heading">Blog</h2>
      <p class="lede">Essays on HCI, UI, and UX — separate from org news.</p>
      <ol class="feed">
        {
          latestBlog.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
              <a class="title" href={`/blog/${post.slug}/`}>
                {post.data.title}
              </a>
              <p>{post.data.description}</p>
            </li>
          ))
        }
      </ol>
      <p><a href="/blog/">All essays →</a></p>
    </section>

    <section class="section" aria-labelledby="demos-heading">
      <h2 id="demos-heading">Demos</h2>
      <p class="lede">
        Interactive experiments, grouped by familiar UI domains — navigation, windowing, settings,
        information architecture, and more.
      </p>
      <p><a href="/demos/">All demos by category →</a></p>
      <div class="viz-grid">
        {featuredDemos.map((demo) => <DemoCard demo={demo} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="news-heading">
      <h2 id="news-heading">News</h2>
      <p class="lede">Org updates as HCI Nerdz takes shape — not essays.</p>
      <ol class="feed">
        {
          latestNews.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
              <a class="title" href={`/news/${post.slug}/`}>
                {post.data.title}
              </a>
              <p>{post.data.description}</p>
            </li>
          ))
        }
      </ol>
      <p><a href="/news/">All news →</a></p>
    </section>
  </main>
</BaseLayout>
