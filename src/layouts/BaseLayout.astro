---
import GitHubLink from '../components/GitHubLink.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { I18N } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'news' | 'blog' | 'docs' | 'demos' | 'philosophy';
}

const {
  title = 'HCI Nerdz',
  description = 'Human-Computer Interaction, User Interface, and User Experience think tank.',
  active,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        const THEME_KEY = 'theme-mode';
        const mql = window.matchMedia('(prefers-color-scheme: dark)');
        const systemTheme = () => (mql.matches ? 'dark' : 'light');
        let override = null;
        try {
          const saved = localStorage.getItem(THEME_KEY);
          if (saved === 'light' || saved === 'dark') override = saved;
        } catch {}
        document.documentElement.dataset.theme = override || systemTheme();
      })();
    </script>
    <style is:global>
      @import '../styles/global.css';
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="HCI Nerdz News" href="/news/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="HCI Nerdz Blog" href="/blog/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nabla:EDPT,EHLT@0..200,0..24&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <slot name="head" />
  </head>
  <body class={active ? `is-${active}` : undefined}>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/logo-mark.svg" width="32" height="32" alt="" />
        HCI Nerdz
      </a>
      <nav class="site-nav" aria-label="Site">
        <div class="nav-inline">
          <a class="nav-link" data-collapse="primary" href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>
            <span data-i18n="nav.blog">Blog</span>
          </a>
          <a class="nav-link" data-collapse="primary" href="/demos/" aria-current={active === 'demos' ? 'page' : undefined}>
            <span data-i18n="nav.demos">Demos</span>
          </a>
          <a class="nav-link" data-collapse="primary" href="https://hci-nerdz.github.io/docs/">
            <span data-i18n="nav.docs">Docs</span>
          </a>
          <a class="nav-link" data-collapse="secondary" href="/news/" aria-current={active === 'news' ? 'page' : undefined}>
            <span data-i18n="nav.news">News</span>
          </a>
          <a
            class="nav-link"
            data-collapse="secondary"
            href="/philosophy/"
            aria-current={active === 'philosophy' ? 'page' : undefined}
          >
            <span data-i18n="nav.philosophy">Philosophy</span>
          </a>
        </div>

        <div class="nav-collapse">
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-drawer"
            data-i18n-aria="nav.menu"
            aria-label="Open menu"
          >
            <span class="nav-toggle-bars" aria-hidden="true"></span>
          </button>

          <div class="nav-drawer" id="nav-drawer" hidden>
            <a class="nav-link" data-collapse="primary" href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>
              <span data-i18n="nav.blog">Blog</span>
            </a>
            <a class="nav-link" data-collapse="primary" href="/demos/" aria-current={active === 'demos' ? 'page' : undefined}>
              <span data-i18n="nav.demos">Demos</span>
            </a>
            <a class="nav-link" data-collapse="primary" href="https://hci-nerdz.github.io/docs/">
              <span data-i18n="nav.docs">Docs</span>
            </a>
            <a class="nav-link" data-collapse="secondary" href="/news/" aria-current={active === 'news' ? 'page' : undefined}>
              <span data-i18n="nav.news">News</span>
            </a>
            <a
              class="nav-link"
              data-collapse="secondary"
              href="/philosophy/"
              aria-current={active === 'philosophy' ? 'page' : undefined}
            >
              <span data-i18n="nav.philosophy">Philosophy</span>
            </a>
          </div>
        </div>
      </nav>

      <div class="nav-chrome">
        <LangSwitcher />
        <GitHubLink class="nav-github" />
        <ThemeSwitcher />
      </div>
    </header>
    <slot />
    <footer class="site-footer" aria-label="Site footer">
      <p class="footer-related-label">Partner organizations</p>
      <ul class="footer-partners">
        <li>
          <a href="https://desktop-tooling.github.io/">Desktop Tooling</a>
          <span>OS-level desktop utilities</span>
        </li>
        <li>
          <a href="https://openshellorg.github.io/">OpenShellOrg</a>
          <span>How CLIs and shells speak and compose</span>
        </li>
        <li>
          <a href="https://devcentr.org">DevCentr</a>
          <span>Environments, orchestration, toolchain management</span>
        </li>
        <li>
          <a href="https://github.com/antora-supplemental">antora-supplemental</a>
          <span>AsciiDoc / Antora publishing UX</span>
        </li>
        <li>
          <a href="https://github.com/dlang-supplemental">dlang-supplemental</a>
          <span>D libraries and native tooling</span>
        </li>
        <li>
          <a href="https://github.com/formatte">formatte</a>
          <span>Formatting ecosystem</span>
        </li>
        <li>
          <a href="https://github.com/LinxPhotos">LinxPhotos</a>
          <span>Photo / portfolio hosting</span>
        </li>
        <li>
          <a href="https://github.com/FoodTruckNerdz">FoodTruckNerdz</a>
          <span>Product domain (food trucks)</span>
        </li>
      </ul>
    </footer>
    <ImageLightbox />
    <script is:inline define:vars={{ I18N }}>
      (function () {
        const SUPPORTED = ['en', 'es', 'fr'];
        const LANG_KEY = 'lang';
        const THEME_KEY = 'theme-mode';

        function pickInitialLang() {
          try {
            const saved = localStorage.getItem(LANG_KEY);
            if (saved && SUPPORTED.includes(saved)) return saved;
          } catch {}
          const nav = (navigator.language || 'en').toLowerCase();
          if (nav.startsWith('es')) return 'es';
          if (nav.startsWith('fr')) return 'fr';
          return 'en';
        }

        function eventEl(e) {
          return e.target instanceof Element ? e.target : e.target.parentElement;
        }

        function closeLangMenus() {
          document.querySelectorAll('[data-lang-switcher]').forEach((root) => {
            const trigger = root.querySelector('[data-lang-trigger]');
            const menu = root.querySelector('[data-lang-menu]');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            if (menu) menu.hidden = true;
          });
        }

        function setLangMenuOpen(root, open) {
          const trigger = root.querySelector('[data-lang-trigger]');
          const menu = root.querySelector('[data-lang-menu]');
          if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (menu) menu.hidden = !open;
        }

        function applyLang(lang) {
          document.documentElement.lang = lang;
          const dict = I18N[lang] || I18N.en;
          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const key = el.getAttribute('data-i18n');
            if (!key) return;
            const v = dict[key];
            if (v) el.textContent = v;
          });
          document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
            const key = el.getAttribute('data-i18n-aria');
            if (!key) return;
            const v = dict[key];
            if (v) el.setAttribute('aria-label', v);
          });
          document.querySelectorAll('[data-lang]').forEach((btn) => {
            btn.setAttribute('aria-selected', btn.getAttribute('data-lang') === lang ? 'true' : 'false');
          });
        }

        function systemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function readThemeOverride() {
          try {
            const saved = localStorage.getItem(THEME_KEY);
            if (saved === 'light' || saved === 'dark') return saved;
          } catch {}
          return null;
        }

        function writeThemeOverride(override) {
          try {
            if (override === 'light' || override === 'dark') localStorage.setItem(THEME_KEY, override);
            else localStorage.removeItem(THEME_KEY);
          } catch {}
        }

        function syncThemeToggle(effective) {
          const dict = I18N[document.documentElement.lang] || I18N.en;
          const key = effective === 'dark' ? 'theme.switch_to_light' : 'theme.switch_to_dark';
          const label = dict[key];
          document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
            btn.setAttribute('aria-pressed', effective === 'dark' ? 'true' : 'false');
            btn.setAttribute('data-i18n-aria', key);
            if (label) btn.setAttribute('aria-label', label);
            const sr = btn.querySelector('.sr-only');
            if (sr && label) {
              sr.setAttribute('data-i18n', key);
              sr.textContent = label;
            }
          });
        }

        function applyTheme(override) {
          const effective = override || systemTheme();
          document.documentElement.dataset.theme = effective;
          document.documentElement.style.colorScheme = effective;
          syncThemeToggle(effective);
        }

        const initLang = pickInitialLang();
        applyLang(initLang);

        applyTheme(readThemeOverride());

        const mql = window.matchMedia('(prefers-color-scheme: dark)');
        mql.addEventListener('change', () => {
          writeThemeOverride(null);
          applyTheme(null);
        });

        const toggle = document.getElementById('nav-toggle');
        const drawer = document.getElementById('nav-drawer');
        let setDrawerOpen = () => {};
        if (toggle && drawer) {
          setDrawerOpen = (open) => {
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            drawer.hidden = !open;
            document.body.classList.toggle('nav-open', open);
            const dict = I18N[document.documentElement.lang] || I18N.en;
            toggle.setAttribute('aria-label', open ? dict['nav.close'] : dict['nav.menu']);
            toggle.setAttribute('data-i18n-aria', open ? 'nav.close' : 'nav.menu');
          };
          toggle.addEventListener('click', () => {
            const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
            if (willOpen) closeLangMenus();
            setDrawerOpen(willOpen);
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          closeLangMenus();
          setDrawerOpen(false);
        });

        document.addEventListener('click', (e) => {
          const el = eventEl(e);
          if (!el) return;

          const option = el.closest('[data-lang]');
          if (option) {
            const v = option.getAttribute('data-lang');
            if (SUPPORTED.includes(v)) {
              try {
                localStorage.setItem(LANG_KEY, v);
              } catch {}
              applyLang(v);
            }
            closeLangMenus();
            return;
          }

          const langTrigger = el.closest('[data-lang-trigger]');
          if (langTrigger) {
            const root = langTrigger.closest('[data-lang-switcher]');
            const willOpen = langTrigger.getAttribute('aria-expanded') !== 'true';
            closeLangMenus();
            setDrawerOpen(false);
            if (root && willOpen) setLangMenuOpen(root, true);
            return;
          }

          if (!el.closest('[data-lang-switcher]')) closeLangMenus();

          if (document.body.classList.contains('nav-open') && toggle && drawer) {
            if (!toggle.contains(el) && !drawer.contains(el)) setDrawerOpen(false);
          }

          const themeBtn = el.closest('[data-theme-toggle]');
          if (!themeBtn) return;
          const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
          const next = current === 'dark' ? 'light' : 'dark';
          writeThemeOverride(next);
          applyTheme(next);
        });
      })();
    </script>
  </body>
</html>
