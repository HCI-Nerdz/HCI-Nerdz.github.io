---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import type { Demo, DemoDateMode } from '../lib/demos';
import { dateModeLabel, formatDemoDate } from '../lib/demos';
import RestingShot from './RestingShot.astro';
import VizCard from './VizCard.astro';

interface Props {
  demo: Demo;
  /** When set with activeDate, show a timeline meta line on the card. */
  dateMode?: DemoDateMode;
  activeDate?: string;
  categoryTitle?: string;
}

const { demo, dateMode, activeDate, categoryTitle } = Astro.props;
const shots = demo.shots ?? [];
const family = shots.length > 1;
const related = demo.related ?? [];
const pub = resolve(process.cwd(), 'public/demo-shots');
const ready = shots.length > 0 && shots.every((s) => existsSync(resolve(pub, `${s.id}-800.webp`)));

const soloSizes =
  '(max-width: 639px) min(18rem, 90vw), (max-width: 1023px) min(18rem, 40vw), 18rem';
const familySizes =
  '(max-width: 639px) min(22rem, 90vw), (max-width: 1023px) min(18rem, 30vw), min(20rem, 28vw)';

const showMeta = Boolean(dateMode && activeDate);
const modeText = dateMode ? dateModeLabel(dateMode) : '';
const dateText = activeDate ? formatDemoDate(activeDate) : '';
---

{
  !ready ? (
    <VizCard
      demo={demo}
      dateMode={dateMode}
      activeDate={activeDate}
      categoryTitle={categoryTitle}
    />
  ) : family ? (
    <article class="viz-card demo-family">
      <a class="demo-family-head" href={demo.href}>
        {
          showMeta ? (
            <p class="demo-meta">
              <time datetime={activeDate}>{dateText}</time>
              <span class="demo-meta-mode">{modeText}</span>
              {categoryTitle ? <span class="demo-meta-cat">{categoryTitle}</span> : null}
            </p>
          ) : null
        }
        <strong>{demo.title}</strong>
        <span>{demo.summary}</span>
      </a>
      <ul class="shot-row">
        {
          shots.map((shot) => (
            <li>
              <a class="shot-tile" href={shot.href}>
                <span class="rl-frame">
                  <RestingShot id={shot.id} alt={`${shot.label} — ${demo.title}`} sizes={familySizes} />
                </span>
                <em>{shot.label}</em>
              </a>
            </li>
          ))
        }
      </ul>
      {
        related.length ? (
          <p class="demo-related-inline">
            {related.map((link, i) => (
              <span>
                {i > 0 ? ' · ' : ''}
                <a href={link.href}>{link.label}</a>
              </span>
            ))}
          </p>
        ) : null
      }
    </article>
  ) : (
    <article class="viz-card">
      <a class="viz-card-main" href={demo.href}>
        <span class="rl-frame rl-frame-solo">
          <RestingShot id={shots[0].id} alt={`${demo.title} screenshot`} sizes={soloSizes} />
        </span>
        {
          showMeta ? (
            <p class="demo-meta">
              <time datetime={activeDate}>{dateText}</time>
              <span class="demo-meta-mode">{modeText}</span>
              {categoryTitle ? <span class="demo-meta-cat">{categoryTitle}</span> : null}
            </p>
          ) : null
        }
        <strong>{demo.title}</strong>
        <span>{demo.summary}</span>
      </a>
      {
        related.length ? (
          <p class="demo-related-inline">
            {related.map((link, i) => (
              <span>
                {i > 0 ? ' · ' : ''}
                <a href={link.href}>{link.label}</a>
              </span>
            ))}
          </p>
        ) : null
      }
    </article>
  )
}
