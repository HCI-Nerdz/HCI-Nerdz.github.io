---
/**
 * Today vs pass-through: real Explorer screenshots inside dark-mode HTML chrome.
 * Labels, notes, and accents live in CSS — not baked into a cream infographic.
 */
interface Props {
  todaySrc?: string;
  passSrc?: string;
}
const {
  todaySrc = '/images/pass-through-extensions/explorer-today.png',
  passSrc = '/images/pass-through-extensions/explorer-passthrough.png',
} = Astro.props;
---

<section class="xcmp" aria-label="Explorer today versus pass-through">
  <div class="xcmp-grid">
    <article class="xcmp-panel">
      <header class="xcmp-head">
        <h2>Today</h2>
        <span class="xcmp-tag xcmp-tag-bad">last suffix</span>
      </header>
      <figure class="xcmp-shot shot">
        <img
          src={todaySrc}
          alt="File Explorer today: appsettings.json.example shown as EXAMPLE File with no Open with handler"
          width="700"
          height="430"
          loading="eager"
        />
      </figure>
      <ul class="xcmp-notes">
        <li>
          Files like <code>appsettings.json.example</code> appear as generic EXAMPLE files.
        </li>
        <li>The inner type is ignored.</li>
        <li>No useful editor association.</li>
      </ul>
    </article>

    <article class="xcmp-panel xcmp-panel-good">
      <header class="xcmp-head">
        <h2>Pass-through</h2>
        <span class="xcmp-tag xcmp-tag-good">peel</span>
      </header>
      <figure class="xcmp-shot shot">
        <img
          src={passSrc}
          alt="File Explorer with pass-through: same file as JSON with example badge, opens with JSON editor"
          width="700"
          height="430"
          loading="eager"
        />
      </figure>
      <ul class="xcmp-notes">
        <li>Meta-suffix peels; content type passes through.</li>
        <li>
          Recognized as <span class="xcmp-accent">JSON</span> with an
          <span class="xcmp-badge">example</span> badge.
        </li>
        <li>Opens with the inner handler; path on disk unchanged.</li>
      </ul>
    </article>
  </div>
  <p class="xcmp-legend">
    Explorer windows are product screenshots (click to expand). Panel labels and notes use site
    tokens —
    <span class="xcmp-accent">teal accent</span>
    for the inner type,
    <span class="xcmp-badge">focus / amber</span>
    for the meta-badge — so the page chrome stays dark-mode native.
  </p>
</section>

<style>
  .xcmp {
    margin: 0 0 1.75rem;
  }

  .xcmp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  @media (max-width: 720px) {
    .xcmp-grid {
      grid-template-columns: 1fr;
    }
  }

  .xcmp-panel {
    margin: 0;
    padding: 1rem 1.05rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.03);
  }

  .xcmp-panel-good {
    border-color: color-mix(in srgb, var(--honesty) 45%, var(--line));
    background: color-mix(in srgb, var(--honesty) 8%, transparent);
  }

  .xcmp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .xcmp-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--paper);
  }

  .xcmp-tag {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  .xcmp-tag-bad {
    background: color-mix(in srgb, #e07070 22%, transparent);
    color: #f0a8a8;
  }

  .xcmp-tag-good {
    background: color-mix(in srgb, var(--honesty) 22%, transparent);
    color: #7dcdc2;
  }

  .xcmp-shot {
    margin: 0 0 0.85rem;
  }

  .xcmp-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--ink-2);
  }

  .xcmp-accent {
    color: var(--honesty);
    font-weight: 600;
  }

  .xcmp-badge {
    color: var(--focus);
    font-weight: 600;
  }

  .xcmp-notes {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--paper-muted);
    font-size: 0.9rem;
  }

  .xcmp-notes li {
    margin-bottom: 0.35rem;
  }

  .xcmp-notes code {
    font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", monospace;
    font-size: 0.85em;
    color: var(--focus);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  .xcmp-legend {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--paper-muted);
    max-width: 44rem;
  }
</style>
