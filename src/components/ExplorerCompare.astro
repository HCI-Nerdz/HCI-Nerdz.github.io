---
/**
 * Dark-mode-native Explorer before/after — layout and copy live in HTML/CSS,
 * not baked into a light cream graphic with a printed palette legend.
 */
interface Props {
  filename?: string;
}
const { filename = 'appsettings.json.example' } = Astro.props;
---

<section class="xcmp" aria-label="Explorer today versus pass-through">
  <div class="xcmp-grid">
    <article class="xcmp-panel">
      <header class="xcmp-head">
        <h2>Today</h2>
        <span class="xcmp-tag xcmp-tag-bad">last suffix</span>
      </header>
      <div class="xcmp-explorer" aria-hidden="true">
        <div class="xcmp-path">C:\app\config</div>
        <div class="xcmp-cols">
          <span>Name</span>
          <span>Type</span>
          <span>Opens with</span>
        </div>
        <div class="xcmp-row">
          <span class="xcmp-name">
            <span class="xcmp-ico xcmp-ico-blank" aria-hidden="true"></span>
            {filename}
          </span>
          <span>EXAMPLE File</span>
          <span class="xcmp-dash">—</span>
        </div>
      </div>
      <ul class="xcmp-notes">
        <li>
          Files like <code>{filename}</code> appear as generic EXAMPLE files.
        </li>
        <li>The inner type is ignored.</li>
        <li>No useful editor association.</li>
      </ul>
    </article>

    <article class="xcmp-panel xcmp-panel-good">
      <header class="xcmp-head">
        <h2>Pass-through</h2>
        <span class="xcmp-tag xcmp-tag-good">peel</span>
      </header>
      <div class="xcmp-explorer" aria-hidden="true">
        <div class="xcmp-path">C:\app\config</div>
        <div class="xcmp-cols">
          <span>Name</span>
          <span>Type</span>
          <span>Opens with</span>
        </div>
        <div class="xcmp-row xcmp-row-good">
          <span class="xcmp-name">
            <span class="xcmp-ico xcmp-ico-json" aria-hidden="true">{'{}'}</span>
            {filename}
          </span>
          <span>
            <span class="xcmp-accent">JSON</span> file (<span class="xcmp-badge">example</span>)
          </span>
          <span class="xcmp-accent">JSON editor</span>
        </div>
      </div>
      <ul class="xcmp-notes">
        <li>Meta-suffix peels; content type passes through.</li>
        <li>
          Recognized as <span class="xcmp-accent">JSON</span> with an
          <span class="xcmp-badge">example</span> badge.
        </li>
        <li>Opens with the inner handler; path on disk unchanged.</li>
      </ul>
    </article>
  </div>
  <p class="xcmp-legend">
    Accents use site tokens —
    <span class="xcmp-accent">honesty / teal</span>
    for the inner type,
    <span class="xcmp-badge">focus / amber</span>
    for the meta-badge — so this block follows dark mode with the rest of the page.
  </p>
</section>

<style>
  .xcmp {
    margin: 0 0 1.75rem;
  }

  .xcmp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  @media (max-width: 720px) {
    .xcmp-grid {
      grid-template-columns: 1fr;
    }
  }

  .xcmp-panel {
    margin: 0;
    padding: 1rem 1.05rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.03);
  }

  .xcmp-panel-good {
    border-color: color-mix(in srgb, var(--honesty) 45%, var(--line));
    background: color-mix(in srgb, var(--honesty) 8%, transparent);
  }

  .xcmp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .xcmp-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--paper);
  }

  .xcmp-tag {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  .xcmp-tag-bad {
    background: color-mix(in srgb, #e07070 22%, transparent);
    color: #f0a8a8;
  }

  .xcmp-tag-good {
    background: color-mix(in srgb, var(--honesty) 22%, transparent);
    color: #7dcdc2;
  }

  .xcmp-explorer {
    border: 1px solid var(--line);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.85rem;
    background: var(--ink-2);
  }

  .xcmp-path {
    padding: 0.4rem 0.7rem;
    font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", monospace;
    font-size: 0.72rem;
    color: var(--paper-muted);
    border-bottom: 1px solid var(--line);
  }

  .xcmp-cols,
  .xcmp-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 0.9fr;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    font-size: 0.78rem;
  }

  .xcmp-cols {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper-muted);
    border-bottom: 1px solid var(--line);
  }

  .xcmp-row {
    font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", monospace;
    color: var(--paper);
    align-items: center;
  }

  .xcmp-row-good {
    background: color-mix(in srgb, var(--honesty) 10%, transparent);
  }

  .xcmp-name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .xcmp-ico {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    border-radius: 1px;
    display: inline-grid;
    place-items: center;
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1;
  }

  .xcmp-ico-blank {
    border: 1px solid var(--paper-muted);
    background: rgba(255, 255, 255, 0.04);
  }

  .xcmp-ico-json {
    background: color-mix(in srgb, var(--honesty) 35%, transparent);
    color: var(--paper);
    border: 1px solid color-mix(in srgb, var(--honesty) 55%, transparent);
  }

  .xcmp-dash {
    color: var(--paper-muted);
  }

  .xcmp-accent {
    color: var(--honesty);
    font-weight: 600;
  }

  .xcmp-badge {
    color: var(--focus);
    font-weight: 600;
  }

  .xcmp-notes {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--paper-muted);
    font-size: 0.9rem;
  }

  .xcmp-notes li {
    margin-bottom: 0.35rem;
  }

  .xcmp-notes code {
    font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", monospace;
    font-size: 0.85em;
    color: var(--focus);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  .xcmp-legend {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--paper-muted);
    max-width: 42rem;
  }
</style>
