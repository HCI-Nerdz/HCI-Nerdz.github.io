---
interface Props {
  id: string;
  alt: string;
  sizes: string;
  widths?: number[];
}

const { id, alt, sizes, widths = [400, 800] } = Astro.props;
const dir = '/demo-shots';
const srcset = widths.map((w) => `${dir}/${id}-${w}.webp ${w}w`).join(', ');
const src = `${dir}/${id}-${Math.max(...widths)}.webp`;
const height = Math.round((Math.max(...widths) * 10) / 16);
---

<img
  class="rl-zoom"
  src={src}
  srcset={srcset}
  sizes={sizes}
  width={Math.max(...widths)}
  height={height}
  alt={alt}
  loading="lazy"
  decoding="async"
/>
